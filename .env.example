# =====================================================================
# Applination — environment variable contract
#
# Two kinds of variable, two different places. Putting one in the wrong
# place fails silently.
#
#   RUNTIME    — read when the container starts.
#                Self-hosted: /mnt/apps-pool/appconfig/applination.env
#                Local dev:   your shell / a .env you source
#
#   BUILD-TIME — inlined into the JS bundle during `docker build`.
#                GitHub -> Settings -> Secrets and variables -> Actions
#                -> Variables tab. Changing one needs a REBUILD, not a
#                container restart. Never put a secret here: the image is
#                public on GHCR and the value ships to the browser.
#
# Note: most Applination configuration (LLM keys, search prefs, inbox
# credentials) does NOT live here — it lives in config.yaml, which is
# bind-mounted into the container and edited from the in-app Setup page.
# =====================================================================

# --- RUNTIME (backend container) -------------------------------------

PYTHON_ENV=production
TZ=America/Los_Angeles

# Browser origins allowed to call the API. When the frontend is served on
# the same hostname (Traefik routes /api to the backend), this is just the
# public origin.
ALLOWED_ORIGINS=https://applination.sanchitarora.me

# --- RUNTIME (frontend container) ------------------------------------

NODE_ENV=production

# --- BUILD-TIME (GitHub Actions variable) ----------------------------

# Base URL the browser uses for API calls. Same-origin in the self-hosted
# setup — Traefik sends /api and /files to the backend on this same host.
# Local dev uses http://127.0.0.1:8000 via web/.env.local.
NEXT_PUBLIC_API_BASE=https://applination.sanchitarora.me
