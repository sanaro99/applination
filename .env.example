# Optional settings for `docker compose up` (docker-compose.yml) and
# scripts/dev.ps1. Copy to `.env` and uncomment what you need. Nothing here is
# required for a local install. `.env` is gitignored; never commit it.

# Public address people use to reach the app. Only needed when it is not
# http://localhost:3000, e.g. behind a Cloudflare Tunnel:
# PUBLIC_URL=https://applination.example.com

# Cloudflare Tunnel token, for `docker compose --profile tunnel up -d`.
# See docs/FREE-HOSTING.md.
# CLOUDFLARE_TUNNEL_TOKEN=

# Encryption key for stored API keys and Gmail tokens. Leave unset to have one
# created at data/secret.key on first start. If you set it, keep it forever:
# a different key cannot read secrets stored with the old one.
# APPLINATION_SECRET_KEY=

# Database password, internal to the compose network. Set before the first
# start; changing it later needs the database volume recreated.
# POSTGRES_PASSWORD=applination

# Port and interface the web app listens on (docker compose only).
# WEB_PORT=3000
# WEB_BIND=127.0.0.1

# Pipeline runs allowed at once across all accounts.
# MAX_CONCURRENT_RUNS=2

# Continuous discovery for the /jobs feed (public sources, no AI calls).
# docker compose defaults to 1; scripts/dev.ps1 leaves it off unless set here.
# CONTINUOUS_DISCOVERY_ENABLED=1

# Set to 0 to hide the shared demo account.
# DEMO_ENABLED=1

# TZ=UTC

# --- Not read from here ------------------------------------------------
# NEXT_PUBLIC_API_BASE is build-time: Next.js inlines it into the browser
# bundle, so it is a Docker build argument (or a GitHub Actions variable for
# the published images), and changing it needs a rebuild. Leave it empty for
# same-origin requests, which every supported setup uses.
#
# AI provider keys, search preferences and Gmail credentials are not
# environment variables. Each account enters them in the app; keys are stored
# encrypted in the database.
#
# The self-hosted reverse-proxy deployment has its own environment template:
# deploy/applination.env.example (see docs/DEPLOYMENT.md).
