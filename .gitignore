# =====================================================================
# Applination — keep personal data and secrets out of the repository.
# A fresh clone starts blank; the onboarding flow (or the *.example
# templates under master_data/templates/) seeds these files locally.
# =====================================================================

# --- Secrets / personal config ---------------------------------------
/config.yaml
/config.yaml.*
/private/

# --- Personal master data (created by onboarding) --------------------
/master_data/resume.yaml
/master_data/bio.md
/master_data/*.docx
/master_data/*.pdf
/master_data/stories/*.md
!/master_data/stories/_INDEX.md
/master_data/cover_letters/examples/*
!/master_data/cover_letters/examples/.gitkeep

# --- Generated artifacts ---------------------------------------------
/output/
/data/app.db
/data/*.db
/data/*.dump
.job_cache.json

# Deploy staging tarballs (docs/DEPLOY-SEATTLE.md Step 1 suggests creating
# these). They contain the full master_data and output trees — never commit
# them; this repository is public.
/*.tgz
/*.tar.gz

# --- Python ----------------------------------------------------------
.venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Node / web ------------------------------------------------------
web/node_modules/
web/.next/
web/out/

# --- OS / editor -----------------------------------------------------
.DS_Store
Thumbs.db

testsprite_tests/tmp/

# Self-hosted WebLLM model + wasm for in-browser inbox classification.
# Downloaded locally (see docs) because some networks block huggingface.co,
# where WebLLM otherwise fetches ~1GB of weights at runtime. Never committed.
/web/public/models/

# Stray build/debug artifacts
/_dump.html
/_layout.js
/_runtime.js
/HANDOFF_PROMPT.md
/logs/

testsprite_tests\tmp\config.json
