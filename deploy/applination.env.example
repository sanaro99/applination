# Goes to /mnt/apps-pool/appconfig/applination.env on the Seattle node.
# Plain KEY=VALUE. No `export`, no quotes (compose keeps quotes literally).
# Read at container start — editing this needs Apps -> applination -> Restart.
#
#   sudo tee /mnt/apps-pool/appconfig/applination.env >/dev/null <<'EOF'
#   ...paste...
#   EOF
#   sudo chmod 600 /mnt/apps-pool/appconfig/applination.env

PYTHON_ENV=production
TZ=America/Los_Angeles
ALLOWED_ORIGINS=https://applination.sanchitarora.me

# --- Database ---------------------------------------------------------
# Generate the password once and never reuse it elsewhere:
#   openssl rand -base64 32
# Both variables must agree: POSTGRES_PASSWORD initialises the applination-db
# container, DATABASE_URL is how the api container connects to it. The host
# `applination-db` is the compose service name on the internal network.
# If the password contains @ : / or ?, percent-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://applination:replace-me@applination-db:5432/applination

# --- Secret encryption ------------------------------------------------
# Encrypts every user's stored LLM API keys and Gmail token (the usersecret
# table). Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# BACK THIS UP SOMEWHERE OUTSIDE THE ZFS SNAPSHOT. A snapshot that dies with
# the pool takes the key with it, and without the key every stored secret is
# undecryptable — every user has to re-enter their keys. Rotating it has the
# same effect, so treat it as permanent.
APPLINATION_SECRET_KEY=replace-me

# --- Runs -------------------------------------------------------------
# How many pipeline runs may execute at once across all users. Each is a
# thread doing network I/O and LLM calls; the per-user cap is always 1.
# Default 2 if unset.
MAX_CONCURRENT_RUNS=2

# --- API key fallback (leave OFF) -------------------------------------
# When enabled, a provider with no configured key falls back to a process
# env var (DEEPSEEK_API_KEY, ANTHROPIC_API_KEY, ...). On a multi-user
# install that means any account with no key of its own silently spends
# YOUR key. Off unless explicitly set; only turn it on for a single-user
# deployment where the server owner is the only user.
# ALLOW_ENV_API_KEYS=1

# LLM keys, Gmail credentials, and search prefs are NOT here. Each user's
# keys are encrypted into the `usersecret` table (see APPLINATION_SECRET_KEY
# above); everything else lives in that user's own config.yaml under
# data/users/<id>/ and is edited from the in-app Setup page.
